{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worktree-guard.sh\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read($PROJECT_DIR/**)",
      "Edit($PROJECT_DIR/**)",
      "Write($PROJECT_DIR/**)",
      "Glob($PROJECT_DIR/**)",
      "Grep($PROJECT_DIR/**)"
    ]
  }
}
